      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"recommendation-service\",method=\"GET\",uri=\"/internal/recommendations/{petId}\",status=\"200\"}[1m])))",
